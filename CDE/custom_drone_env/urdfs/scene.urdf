<?xml version="1.0" ?>
<robot name="basic_scene">
  
  <link name="ground_plane">
    <!-- Setting mass to 0 makes it a static (unmoving) object -->
    <inertial>
      <mass value="0.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    
    <visual>
      <!-- We shift the box down slightly so z=0 is exactly the floor surface -->
      <origin rpy="0 0 0" xyz="0 0 -0.5"/>
      <geometry>
        <box size="20 20 1"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.5"/>
      <geometry>
        <box size="20 20 1"/>
      </geometry>
    </collision>
  </link>
  
</robot>
